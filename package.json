{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "lint": "eslint resources/js --fix",
    "lint:check": "eslint resources/js",
    "typecheck": "vue-tsc --noEmit --incremental",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "npm -C docs/vitepress run dev",
    "docs:build": "npm -C docs/vitepress run build",
    "docs:preview": "npm -C docs/vitepress run preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "laravel-echo": "^2.3.0",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.8.1",
    "pusher-js": "^8.4.0",
    "shadcn-vue": "^2.4.3",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vee-validate": "^4.15.1",
    "vite": "^7.0.7",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.4",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  }
}
